# Copy to .env and fill in for your environment.

PORT=3000
DATA_DIR=./data

# AI remediation (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_FIXER_ENABLED=true
# Set to true to disable real AI calls even if a key is present (e.g. in CI).
AI_FIXER_DRY_RUN=false

# Deploy target for validated fixes
REPO_ROOT=.
PROD_BRANCH=prod
GIT_REMOTE=origin
DEPLOY_WEBHOOK_URL=

# Command run to validate a candidate fix before pushing it.
TEST_COMMAND=npm test

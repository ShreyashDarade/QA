# Copy to .env and fill in for your environment.

PORT=3000
DATA_DIR=./data

# AI remediation (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_FIXER_ENABLED=true
# Set to true to disable real AI calls even if a key is present (e.g. in CI).
AI_FIXER_DRY_RUN=false

# Deploy targets: a fix is pushed to DEV_BRANCH, live-validated there, then
# promoted to PROD_BRANCH once validation passes.
REPO_ROOT=.
DEV_BRANCH=dev
PROD_BRANCH=prod
GIT_REMOTE=origin
DEPLOY_WEBHOOK_URL=

# Command run as a fast local gate before a fix is even pushed to dev.
# Default runs lint + format check + the full test suite.
TEST_COMMAND=npm run verify

# How many retrieve/analyze/fix/deploy/test cycles to attempt per error
# before giving up.
MAX_REMEDIATION_CYCLES=5

# Kubernetes restart after pushing to dev. Leave K8S_DEPLOYMENT blank to
# skip this step (the loop still runs, it just won't restart anything).
K8S_NAMESPACE=default
K8S_DEPLOYMENT=
KUBECTL_PATH=kubectl
K8S_ROLLOUT_TIMEOUT=120s

# Postman collection executed against the redeployed service. Leave blank
# to skip this step (treated as passing). See postman/example.postman_collection.json.
POSTMAN_COLLECTION_PATH=
POSTMAN_BASE_URL=http://localhost:3000

# Log-monitoring windows: short one right after each test cycle, longer one
# after a fix is promoted to prod to confirm the service stays stable.
MONITOR_WINDOW_MS=30000
MONITOR_POLL_INTERVAL_MS=3000
POST_DEPLOY_MONITOR_WINDOW_MS=60000
